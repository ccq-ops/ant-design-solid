{
  "name": "@solid-ant-design/core",
  "version": "0.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccq-ops/ant-design-solid.git",
    "directory": "packages/components"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/ssr/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/ssr/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "browser": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/*/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/*/index.d.ts",
          "default": "./dist/ssr/*/index.js"
        },
        "require": {
          "types": "./dist/*/index.d.cts",
          "default": "./dist/ssr/*/index.cjs"
        }
      },
      "import": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/*/index.js"
      },
      "require": {
        "types": "./dist/*/index.d.cts",
        "default": "./dist/*/index.cjs"
      }
    },
    "./locale/*": {
      "browser": {
        "types": "./dist/locale/*/index.d.ts",
        "default": "./dist/locale/*/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/locale/*/index.d.ts",
          "default": "./dist/ssr/locale/*/index.js"
        },
        "require": {
          "types": "./dist/locale/*/index.d.cts",
          "default": "./dist/ssr/locale/*/index.cjs"
        }
      },
      "import": {
        "types": "./dist/locale/*/index.d.ts",
        "default": "./dist/locale/*/index.js"
      },
      "require": {
        "types": "./dist/locale/*/index.d.cts",
        "default": "./dist/locale/*/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && BUILD_SSR=1 vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../scripts/fix-declarations.mjs dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@solid-ant-design/cssinjs": "workspace:*",
    "@solid-ant-design/icons": "workspace:*",
    "@solid-ant-design/theme": "workspace:*",
    "@tanstack/solid-virtual": "^3.13.28",
    "dayjs": "^1.11.13",
    "qrcode-generator": "^2.0.4",
    "solid-motionone": "^1.0.4"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
